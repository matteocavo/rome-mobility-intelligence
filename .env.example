ENVIRONMENT=development
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_CLIENT_ID=replace-with-workload-client-id
# Configure exactly one source: private environment secret OR a Windows credential target.
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CREDENTIAL_TARGET=rome-mobility-intelligence/databricks/oauth-m2m
DATABRICKS_CATALOG=rome_transport
DATABRICKS_SCHEMA=features
TRAINING_TABLE=next_stop_delay_labeled
INFERENCE_TABLE=next_stop_delay_scoring
# Leave empty for skeleton mode; configure only a trusted, local artifact bundle.
MODEL_ARTIFACT_PATH=
MODEL_ARTIFACT_ROOT=
MODEL_ARTIFACT_MANIFEST_SHA256=
DATABRICKS_QUERY_TIMEOUT_SECONDS=120
DATABRICKS_QUEUE_TIMEOUT_SECONDS=1
DATABRICKS_MAX_CONCURRENT_QUERIES=1
INFERENCE_MAX_BATCH_ROWS=100
INFERENCE_MAX_BYTES=8000000
