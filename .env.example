ENVIRONMENT=development
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_CLIENT_ID=replace-with-workload-client-id
# Configure exactly one source: private environment secret OR a Windows credential target.
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CREDENTIAL_TARGET=rome-mobility-intelligence/databricks/oauth-m2m
DATABRICKS_CATALOG=rome_transport
DATABRICKS_SCHEMA=features
TRAINING_TABLE=next_stop_delay_labeled
INFERENCE_TABLE=next_stop_delay_scoring
# Leave empty for skeleton mode; configure only a trusted, local artifact bundle.
MODEL_ARTIFACT_PATH=
MODEL_ARTIFACT_ROOT=
MODEL_ARTIFACT_MANIFEST_SHA256=
DATABRICKS_QUERY_TIMEOUT_SECONDS=120
DATABRICKS_QUEUE_TIMEOUT_SECONDS=1
DATABRICKS_MAX_CONCURRENT_QUERIES=1
INFERENCE_MAX_BATCH_ROWS=100
INFERENCE_MAX_BYTES=8000000
# Private PostgreSQL DSN; leave unset until a dedicated local database is configured.
DATABASE_URL=
ENABLE_PREDICTION_PERSISTENCE=false
DATABASE_POOL_SIZE=2
DATABASE_POOL_TIMEOUT_SECONDS=3
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
HISTORY_MAX_ROWS=200
HISTORY_MAX_RANGE_DAYS=7
# Server-side only. No n8n administrative API key is used.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_ALLOWED_HOST=
N8N_WEBHOOK_TIMEOUT_SECONDS=5
# Inbound service auth; distinct from N8N_WEBHOOK_SECRET. Required for operational API calls.
N8N_SERVICE_API_KEY=
ALLOWED_HOSTS=["localhost","127.0.0.1","::1","testserver"]
CORS_ALLOWED_ORIGINS=[]
REQUEST_MAX_BYTES=262144
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_INFERENCE=10
RATE_LIMIT_WRITE=2
RATE_LIMIT_READ=60
