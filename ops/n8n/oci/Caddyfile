{
    email {$ACME_EMAIL}
    admin off
    log {
        level WARN
    }
}

{$N8N_HOST} {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    request_body {
        max_size 1MB
    }
    reverse_proxy n8n:5678
    # No access logging: request headers and execution payloads are not collected.
}
