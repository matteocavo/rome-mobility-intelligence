# Configuration only. Copy outside Git, e.g. /etc/rome-mobility-n8n/deployment.env.
# Invalid placeholder: replace before deployment. No paid domain required.
N8N_HOST=replace.invalid
ACME_EMAIL=operator@example.org
N8N_DATA_DIR=/var/lib/rome-mobility-n8n/n8n
CADDY_DATA_DIR=/var/lib/rome-mobility-n8n/caddy-data
CADDY_CONFIG_DIR=/var/lib/rome-mobility-n8n/caddy-config
# File CONTENT is N8N_ENCRYPTION_KEY, generated privately by operator, never here.
N8N_ENCRYPTION_KEY_FILE=/etc/rome-mobility-n8n/encryption.key
