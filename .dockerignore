# Deny context by default; private models arrive via trusted mounts or BuildKit secrets.
**
!Dockerfile
!Dockerfile.zero-cost
!requirements-runtime.txt
!app/
!app/**
!scripts/
!scripts/__init__.py
!scripts/serve.py
!scripts/healthcheck.py
!scripts/bootstrap_model.py
**/__pycache__/**
**/.env*
**/.databricks/**
**/.databrickscfg
**/.secrets/**
**/credentials.json
**/token*.json
**/*.joblib
**/*.pkl
**/*.pickle
**/*.parquet
**/*.csv
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tmp
**/*.bak
