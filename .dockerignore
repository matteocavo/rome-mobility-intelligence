# Deny build context by default; model and credentials arrive through protected runtime mounts.
**
!Dockerfile
!requirements-runtime.txt
!app/
!app/**
!scripts/
!scripts/__init__.py
!scripts/serve.py
!scripts/healthcheck.py
**/__pycache__/**
**/.env*
**/.databricks/**
**/.databrickscfg
**/.secrets/**
**/credentials.json
**/token*.json
**/*.joblib
**/*.pkl
**/*.pickle
**/*.parquet
**/*.csv
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tmp
**/*.bak
